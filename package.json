  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "light",
    "flat",
    "minimal"
  ],
  "galleryBanner": {
    "color": "#252525",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "SurpassOne Dark",
        "uiTheme": "vs-dark",
