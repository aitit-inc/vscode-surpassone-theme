  "description": "A flat, minimal color theme with coral accents. Easy on the eyes for daily use.",
  "version": "0.1.0",
  "publisher": "surpassone",
  "license": "MIT",
  "icon": "surpassone-logo-640.png",
  "repository": {
    "type": "git",
