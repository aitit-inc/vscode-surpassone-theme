{
  "$schema": "vscode://schemas/color-theme",
  "name": "SurpassOne Dark",
  "type": "dark",
  "colors": {
    "focusBorder": "#E8755E80",
    "foreground": "#D5D6DB",
    "widget.shadow": "#00000000",
    "selection.background": "#E8755E30",

    "editor.background": "#23242A",
    "editor.foreground": "#D5D6DB",
    "editorCursor.foreground": "#E8755E",
    "editor.selectionBackground": "#E8755E30",
    "editor.inactiveSelectionBackground": "#E8755E15",
    "editor.findMatchBackground": "#E8755E50",
    "editor.findMatchHighlightBackground": "#E8755E25",
    "editor.lineHighlightBackground": "#E8755E0A",
    "editor.wordHighlightBackground": "#FFFFFF12",
    "editor.wordHighlightStrongBackground": "#FFFFFF18",
    "editorLineNumber.foreground": "#47484F",
    "editorLineNumber.activeForeground": "#86878C",
    "editorIndentGuide.background": "#2C2D33",
    "editorIndentGuide.activeBackground": "#37383F",
    "editorBracketMatch.background": "#FFFFFF15",
    "editorBracketMatch.border": "#FFFFFF00",
    "editorRuler.foreground": "#2C2D33",
    "editorOverviewRuler.border": "#FFFFFF00",
    "editorGutter.modifiedBackground": "#D4A76A",
    "editorGutter.addedBackground": "#8B9E78",
    "editorGutter.deletedBackground": "#E8755E",
    "editorError.foreground": "#E8755E",
    "editorWarning.foreground": "#D4A76A",
    "editorInfo.foreground": "#6EADB0",

    "editorBracketHighlight.foreground1": "#E8755E",
    "editorBracketHighlight.foreground2": "#D5D6DB",
    "editorBracketHighlight.foreground3": "#86878C",
    "editorBracketHighlight.foreground4": "#E8755E",
    "editorBracketHighlight.foreground5": "#D5D6DB",
    "editorBracketHighlight.foreground6": "#86878C",

    "editorWidget.background": "#28292F",
    "editorWidget.border": "#2E2F35",
    "editorSuggestWidget.background": "#28292F",
    "editorSuggestWidget.border": "#2E2F35",
    "editorSuggestWidget.selectedBackground": "#323339",

    "editorGroupHeader.tabsBackground": "#23242A",
    "editorGroup.border": "#2C2D33",

    "tab.activeBackground": "#23242A",
    "tab.activeForeground": "#D5D6DB",
    "tab.inactiveBackground": "#23242A",
    "tab.inactiveForeground": "#64656A",
    "tab.border": "#FFFFFF00",
    "tab.activeBorderTop": "#E8755E",

    "sideBar.background": "#23242A",
    "sideBar.foreground": "#96979C",
    "sideBar.border": "#FFFFFF00",
    "sideBarTitle.foreground": "#D5D6DB",
    "sideBarSectionHeader.background": "#FFFFFF00",
    "sideBarSectionHeader.foreground": "#96979C",

    "activityBar.background": "#1A1B21",
    "activityBar.foreground": "#D5D6DB",
    "activityBar.inactiveForeground": "#64656A",
    "activityBar.border": "#FFFFFF00",
    "activityBarBadge.background": "#E8755E",
    "activityBarBadge.foreground": "#FFFFFF",

    "statusBar.background": "#1A1B21",
    "statusBar.foreground": "#96979C",
    "statusBar.border": "#FFFFFF00",
    "statusBar.debuggingBackground": "#E8755E",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#23242A",

    "titleBar.activeBackground": "#1A1B21",
    "titleBar.activeForeground": "#96979C",
    "titleBar.inactiveBackground": "#1A1B21",
    "titleBar.inactiveForeground": "#64656A",
    "titleBar.border": "#FFFFFF00",

    "panel.background": "#23242A",
    "panel.border": "#2C2D33",
    "panelTitle.activeForeground": "#D5D6DB",
    "panelTitle.activeBorder": "#E8755E",
    "panelTitle.inactiveForeground": "#64656A",

    "input.background": "#2C2D33",
    "input.foreground": "#D5D6DB",
    "input.border": "#FFFFFF00",
    "input.placeholderForeground": "#64656A",
    "inputOption.activeBorder": "#E8755E",

    "dropdown.background": "#2C2D33",
    "dropdown.foreground": "#D5D6DB",
    "dropdown.border": "#FFFFFF00",

    "button.background": "#D0705A",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#DC8070",
    "button.secondaryBackground": "#37383F",
    "button.secondaryForeground": "#D5D6DB",

    "badge.background": "#E8755E",
    "badge.foreground": "#FFFFFF",

    "list.activeSelectionBackground": "#303137",
    "list.activeSelectionForeground": "#D5D6DB",
    "list.hoverBackground": "#28292F",
    "list.inactiveSelectionBackground": "#2B2C32",
    "list.highlightForeground": "#E8755E",
    "list.focusHighlightForeground": "#E8755E",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#FFFFFF10",
    "scrollbarSlider.hoverBackground": "#FFFFFF20",
    "scrollbarSlider.activeBackground": "#FFFFFF30",

    "minimap.selectionHighlight": "#E8755E60",

    "peekView.border": "#E8755E",
    "peekViewEditor.background": "#23242A",
    "peekViewResult.background": "#23242A",
    "peekViewTitle.background": "#23242A",
    "peekViewTitleLabel.foreground": "#D5D6DB",
    "peekViewTitleDescription.foreground": "#86878C",

    "terminal.foreground": "#D5D6DB",
    "terminal.background": "#23242A",
    "terminal.ansiBlack": "#23242A",
    "terminal.ansiRed": "#E8755E",
    "terminal.ansiGreen": "#8B9E78",
    "terminal.ansiYellow": "#D4A76A",
    "terminal.ansiBlue": "#6EADB0",
    "terminal.ansiMagenta": "#B07EA8",
    "terminal.ansiCyan": "#6EADB0",
    "terminal.ansiWhite": "#D5D6DB",
    "terminal.ansiBrightBlack": "#64656A",
    "terminal.ansiBrightRed": "#F08B76",
    "terminal.ansiBrightGreen": "#A0B48E",
    "terminal.ansiBrightYellow": "#E0BD84",
    "terminal.ansiBrightBlue": "#88C4C6",
    "terminal.ansiBrightMagenta": "#C498BC",
    "terminal.ansiBrightCyan": "#88C4C6",
    "terminal.ansiBrightWhite": "#E0E0E0",

    "gitDecoration.modifiedResourceForeground": "#D4A76A",
    "gitDecoration.untrackedResourceForeground": "#8B9E78",
    "gitDecoration.deletedResourceForeground": "#E8755E",
    "gitDecoration.conflictingResourceForeground": "#D4A76A",
    "gitDecoration.ignoredResourceForeground": "#54555A",

    "breadcrumb.foreground": "#86878C",
    "breadcrumb.focusForeground": "#D5D6DB",
    "breadcrumb.activeSelectionForeground": "#D5D6DB",
    "breadcrumbPicker.background": "#28292F",

    "settings.headerForeground": "#D5D6DB",
    "settings.modifiedItemIndicator": "#E8755E",

    "notificationCenter.border": "#FFFFFF00",
    "notifications.background": "#28292F",
    "notifications.foreground": "#D5D6DB",
    "notifications.border": "#FFFFFF00",
    "notificationsErrorIcon.foreground": "#E8755E",
    "notificationsWarningIcon.foreground": "#D4A76A",
    "notificationsInfoIcon.foreground": "#6EADB0"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#64656A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.other.using",
        "keyword.other.directive"
      ],
      "settings": {
        "foreground": "#B88A80"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "keyword.operator.expression"],
      "settings": {
        "foreground": "#86878C"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#E8755E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "Built-in constant",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "Variable language (this, self)",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#E8755E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#D0806E"
      }
    },
    {
      "name": "Function definition",
      "scope": ["entity.name.function"],
      "settings": {
        "foreground": "#E8755E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function call",
      "scope": ["support.function", "meta.function-call"],
      "settings": {
        "foreground": "#D5D6DB"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable"
      ],
      "settings": {
        "foreground": "#D5D6DB"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#D5D6DB"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "#86878C"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#E8755E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "Decorator / Annotation",
      "scope": [
        "meta.decorator",
        "meta.decorator entity.name.function",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#B88A80"
      }
    },
    {
      "name": "CSS property name",
      "scope": ["support.type.property-name.css", "support.type.property-name.scss", "support.type.property-name.less"],
      "settings": {
        "foreground": "#D5D6DB"
      }
    },
    {
      "name": "CSS value",
      "scope": ["support.constant.property-value.css", "support.constant.color.css"],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "CSS unit",
      "scope": ["keyword.other.unit.css", "keyword.other.unit.scss"],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#E8755E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#A8A9AE"
      }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#D5D6DB"
      }
    },
    {
      "name": "YAML key",
      "scope": ["entity.name.tag.yaml"],
      "settings": {
        "foreground": "#D5D6DB"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "type": "#D0806E",
    "class": "#D0806E",
    "interface": "#D0806E",
    "enum": "#D0806E",
    "enumMember": "#A8A9AE",
    "namespace": "#D5D6DB",
    "function.declaration": { "foreground": "#E8755E", "fontStyle": "bold" },
    "method.declaration": { "foreground": "#E8755E", "fontStyle": "bold" },
    "function": "#D5D6DB",
    "method": "#D5D6DB",
    "parameter": "#D5D6DB",
    "property": "#D5D6DB",
    "variable": "#D5D6DB",
    "variable.readonly": "#D5D6DB"
  }
}
